"# Local AI server URL — the OpenAI-compatible endpoint to use for generation.
# Default points to KoboldCpp on its standard port. Change this to match your runner:
#
#   KoboldCpp (default):  http://127.0.0.1:5001/v1
#   LM Studio:            http://127.0.0.1:1234/v1
#   Ollama:               http://127.0.0.1:11434/v1
#
# Copy this file to .env.local and set your value. .env.local is gitignored.
VITE_LOCAL_AI_URL=http://127.0.0.1:5001/v1

# Set to "true" to disable Vite HMR (hot module replacement).
# Useful when running the dev server inside WSL, Docker, or other container setups
# where the browser and dev server are on different network namespaces.
DISABLE_HMR=false
"